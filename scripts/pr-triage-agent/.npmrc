# opencode-ai's bin wrapper resolves its platform binary via
#     node_modules/opencode-{platform}-{arch}/bin/opencode
# with a plain `path.join`, so the optional dep MUST be hoisted to the top-level
# node_modules. pnpm's default (isolated) linker only symlinks direct deps and
# would leave the wrapper failing with "your package manager failed to install
# the right version of the opencode CLI for your platform". This package only
# pulls opencode-ai, so a flat layout has no isolation downside here.
node-linker=hoisted
